rules_version = '2';

// MochiBuddy Firestore security rules.
//
// The entire data model lives under users/{uid} (mochi-design-doc.md):
// every user — including anonymous/guest sessions — may touch ONLY their
// own subtree. Everything else is denied by default.
//
// Deploy: Firebase console → Firestore → Rules, or
//   firebase deploy --only firestore:rules
//
// These rules are the reason the client's account-deletion flow erases the
// Firestore subtree BEFORE deleting the Auth user: once the uid is gone,
// nothing can ever read or delete the orphaned documents.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // adoptedOn is write-once (Personal Layer, Feature 1): settable when
    // absent, then immutable and undeletable. Client code preserving the
    // invariant is a courtesy; this rule is the guarantee. Note setData
    // merges produce the post-write doc in request.resource.data, so an
    // equality check covers updates and attempted field deletes alike.
    function adoptedOnPreserved() {
      return !('adoptedOn' in resource.data)
          || (('adoptedOn' in request.resource.data)
              && request.resource.data.adoptedOn == resource.data.adoptedOn);
    }

    match /users/{uid} {
      allow read, create, delete: if isOwner(uid);
      allow update: if isOwner(uid) && adoptedOnPreserved();

      match /tasks/{taskId} {
        allow read, write: if isOwner(uid);
      }

      match /lists/{listId} {
        allow read, write: if isOwner(uid);
      }

      // Letters are immutable postcards (Personal Layer, Feature 3):
      // created exactly once (first composer wins via the client
      // transaction; create-only here is the guarantee), then readAt is
      // the ONE mutable field. Delete stays open for account erasure -
      // the app offers no per-letter delete UI.
      match /letters/{letterId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      }

      // Weekly engagement markers (Feature 3's dormancy arbiter):
      // create-only facts - a marker can never be edited into existence
      // after the fact or reworded. Delete stays open for erasure.
      match /activityWeeks/{periodId} {
        allow read, create, delete: if isOwner(uid);
      }

      // Future subcollections stay closed until explicitly opened:
      // no match, no access.
    }

    // Default deny: any path not matched above is unreachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
